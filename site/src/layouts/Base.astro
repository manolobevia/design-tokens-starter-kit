---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string; noindex?: boolean; overlay?: boolean; }
const { title, description, noindex = false, overlay = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <script is:inline>if(!matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("anim")</script>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Design Token Skills" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content="https://designtokenskills.com/social-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content="Type one line. Watch Figma fill with tokens. Design Token Skills writes an 11-step purple color scale into Figma variables." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://designtokenskills.com/social-preview.png" />
    <meta name="twitter:image:alt" content="Type one line. Watch Figma fill with tokens. Design Token Skills writes an 11-step purple color scale into Figma variables." />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#08080b" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cal+Sans&family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlay} />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline data-goatcounter="https://designtokenskills.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
