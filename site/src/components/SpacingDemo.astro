---
const steps = [1, 2, 3, 4, 6, 8, 12, 16, 24];
---
<div class="demo" data-reveal>
  <ul>
    {steps.map((t, i) => (
      <li style={`--w:${t * 4}px;--i:${i}`}>
        <span class="mono label">Spacing/{t}</span>
        <span class="bar"></span>
        <span class="mono px">{t * 4}px</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .demo { padding: var(--brand-space-6); background: var(--surface-raised); border: var(--brand-border-1) solid var(--border-default); border-radius: var(--brand-radius-4); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
  li { display: grid; grid-template-columns: 6rem 1fr 3.5rem; align-items: center; gap: var(--brand-space-3); padding-block: 6px; font-size: 0.85rem; }
  .label { color: var(--text-secondary); }
  .bar { height: 14px; width: var(--w); max-width: 100%; background: var(--surface-action); border-radius: var(--brand-radius-1); }
  .px { color: var(--text-heading); text-align: right; }
  :global(.anim) .demo:not(.in) .bar { width: 0; }
  :global(.anim) .bar { transition: width 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 0.07s); }
</style>
