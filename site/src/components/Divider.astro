---
// A hairline that fades out at both ends, with a small ornament that hints at the skill that follows.
interface Props { kind: string; }
const { kind } = Astro.props;

const ornaments: Record<string, { paths: string[]; fill?: string[] }> = {
  alias: { paths: ['M12 16h8', 'M17 13l3 3-3 3'], fill: [] },
  mapped: { paths: ['M16 7a9 9 0 1 0 0 18a9 9 0 0 0 0-18z'], fill: ['M16 7a9 9 0 0 1 0 18z'] },
  spacing: { paths: ['M6 9v14', 'M26 9v14', 'M6 16h20', 'M10 12l-4 4 4 4', 'M22 12l4 4-4 4'] },
  type: { paths: ['M6 24 11 8l5 16', 'M8 19h6', 'M21 24v-9', 'M21 17a3.5 3.5 0 1 1 0 5'] },
  shape: { paths: ['M12 7h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5h-8a5 5 0 0 1-5-5v-8a5 5 0 0 1 5-5z'] },
  motion: { paths: ['M5 25C16 25 14 7 27 7'], fill: [] },
  contrast: { paths: ['M16 7a9 9 0 1 0 0 18a9 9 0 0 0 0-18z', 'M12 16.5l3 3 5.5-6'] },
  export: { paths: ['M12 6c-3 0-4 1.5-4 4v2c0 2-1 3-3 4 2 1 3 2 3 4v2c0 2.5 1 4 4 4', 'M20 6c3 0 4 1.5 4 4v2c0 2 1 3 3 4-2 1-3 2-3 4v2c0 2.5-1 4-4 4'] },
  starter: { paths: ['M16 4l3 9 9 3-9 3-3 9-3-9-9-3 9-3z'] },
  docs: { paths: ['M7 6h18a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z', 'M10 12h12', 'M10 16h12', 'M10 20h7'] },
};
const o = ornaments[kind] ?? ornaments.starter;
---
<div class="divider" data-reveal role="separator" aria-hidden="true">
  <span class="line"></span>
  <span class="dot"></span>
  <svg class="orn" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {o.fill?.map((d) => <path d={d} fill="currentColor" stroke="none" />)}
    {o.paths.map((d) => <path d={d} />)}
  </svg>
  <span class="dot"></span>
  <span class="line line--r"></span>
</div>

<style>
  .divider { display: flex; align-items: center; gap: var(--brand-space-3); margin-top: var(--brand-space-16); color: var(--text-link); }
  .line { flex: 1; height: 1px; background: linear-gradient(to right, transparent, var(--border-control)); transform-origin: right center; }
  .line--r { background: linear-gradient(to left, transparent, var(--border-control)); transform-origin: left center; }
  .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--border-control); flex: none; }
  .orn { flex: none; }
  :global(.anim) .divider:not(.in) .line { transform: scaleX(0); }
  :global(.anim) .divider:not(.in) .orn, :global(.anim) .divider:not(.in) .dot { opacity: 0; transform: scale(0.6); }
  :global(.anim) .line { transition: transform 0.7s ease; }
  :global(.anim) .orn, :global(.anim) .dot { transition: opacity 0.5s ease 0.35s, transform 0.5s ease 0.35s; }
</style>
