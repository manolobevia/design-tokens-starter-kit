---
import { scale, ink } from '../scripts/scale';
const picks = ['950', '700', '500', '300', '50'];
const steps = scale('#5C3FC4').filter((s) => picks.includes(s.step));
---
<div class="demo" data-reveal>
  <p class="mono line">Brand/Purple -&gt; Alias/Primary (Purple)</p>
  <ul class="pairs">
    {steps.map((s, i) => (
      <li style={`--c:${s.hex};--ink:${ink(s.hex)};--i:${i}`}>
        <span class="chip mono">Brand/Purple/{s.step}</span>
        <span class="arrow" aria-hidden="true"></span>
        <span class="chip alias mono">Alias/Primary/{s.step}</span>
      </li>
    ))}
  </ul>
  <p class="note">Each Alias variable is a reference, never a copied hex. Change the brand color and every role follows.</p>
</div>

<style>
  .demo { padding: var(--brand-space-6); background: var(--surface-raised); border: var(--brand-border-1) solid var(--border-default); border-radius: var(--brand-radius-4); display: flex; flex-direction: column; gap: var(--brand-space-4); }
  .line { background: var(--surface-sunken); padding: var(--brand-space-2) var(--brand-space-3); border-radius: var(--brand-radius-2); color: var(--text-heading); overflow-wrap: anywhere; }
  .pairs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--brand-space-2); }
  .pairs li { display: grid; grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr); align-items: center; gap: var(--brand-space-2); }
  .chip { padding: 6px var(--brand-space-3); border-radius: var(--brand-radius-2); background: var(--c); color: var(--ink); font-size: 0.78rem; overflow-wrap: anywhere; }
  .alias { outline: var(--brand-border-1) dashed var(--ink); outline-offset: -4px; }
  .arrow { height: 2px; background: var(--text-secondary); position: relative; transform-origin: left; }
  .arrow::after { content: ''; position: absolute; right: 0; top: -4px; border-left: 8px solid var(--text-secondary); border-block: 5px solid transparent; }
  .note { color: var(--text-secondary); font-size: 0.95rem; }
  :global(.anim) .demo:not(.in) .arrow { transform: scaleX(0); }
  :global(.anim) .demo:not(.in) .alias { opacity: 0; }
  :global(.anim) .arrow { transition: transform 0.5s ease calc(var(--i) * 0.12s); }
  :global(.anim) .alias { transition: opacity 0.4s ease calc(var(--i) * 0.12s + 0.4s); }
</style>
