---
import { scale, ink } from '../scripts/scale';
const name = 'Purple';
const hex = '#5C3FC4';
const steps = scale(hex);
---
<div class="demo" data-color-demo>
  <div class="fields">
    <label>Name <input data-name type="text" value={name} maxlength="20" autocomplete="off" spellcheck="false" /></label>
    <label>Hex <input data-hex type="color" value={hex.toLowerCase()} /></label>
    <p class="mono line" data-line>{name}:{hex}</p>
  </div>
  <ol class="rows" data-rows>
    {steps.map((s) => (
      <li style={`--c:${s.hex};--ink:${ink(s.hex)}`}>
        <span>{name}/{s.step}{s.step === '500' ? ' Default' : ''}</span><span class="mono">{s.hex}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .demo { padding: var(--brand-space-6); background: var(--surface-raised); border: var(--brand-border-1) solid var(--border-default); border-radius: var(--brand-radius-4); }
  .fields { display: flex; flex-wrap: wrap; gap: var(--brand-space-4); align-items: end; margin-bottom: var(--brand-space-4); }
  label { display: flex; flex-direction: column; gap: var(--brand-space-1); font-size: 0.85rem; color: var(--text-secondary); }
  input[type='text'] { background: var(--surface-sunken); border: var(--brand-border-1) solid var(--border-control); border-radius: var(--brand-radius-2); color: var(--text-heading); padding: var(--brand-space-2) var(--brand-space-3); font: inherit; width: 9rem; }
  input[type='color'] { width: 4rem; height: 2.5rem; padding: 2px; background: var(--surface-sunken); border: var(--brand-border-1) solid var(--border-control); border-radius: var(--brand-radius-2); }
  .line { margin-left: auto; color: var(--text-heading); }
  .rows { list-style: none; margin: 0; padding: 0; border-radius: var(--brand-radius-3); overflow: hidden; }
  .rows li { display: flex; justify-content: space-between; padding: 6px var(--brand-space-3); background: var(--c); color: var(--ink); font-size: 0.85rem; }
  .rows li > :first-child { font-family: var(--brand-font-mono); }
</style>
