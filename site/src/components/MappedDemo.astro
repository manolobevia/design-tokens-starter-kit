---
import { stepHex } from '../scripts/scale';

const N = (s: string) => stepHex('#6B7280', s); // Gray feeds Alias/Neutral
const P = (s: string) => stepHex('#5C3FC4', s);
const WHITE = '#FFFFFF';

// [variable, light alias, dark alias] from the figma-mapped-roles PRESET; dark is the mirror unless listed.
const rows: [string, string, string, string, string][] = [
  ['Surface/page', 'Neutral/50', N('50'), 'Neutral/950', N('950')],
  ['Surface/default', 'White', WHITE, 'Neutral/900', N('900')],
  ['Surface/action', 'Primary/500', P('500'), 'Primary/500', P('500')],
  ['Surface/action-secondary', 'Primary/50', P('50'), 'Primary/800', P('800')],
  ['Text/heading', 'Neutral/900', N('900'), 'Neutral/100', N('100')],
  ['Text/body', 'Neutral/700', N('700'), 'Neutral/300', N('300')],
  ['Text/action', 'Primary/500', P('500'), 'Primary/200', P('200')],
  ['Text/on-action', 'White', WHITE, 'White', WHITE],
  ['Border/secondary', 'Neutral/200', N('200'), 'Neutral/700', N('700')],
];
const light = rows.map((r) => `--${r[0].replace('/', '-')}:${r[2]}`).join(';');
const dark = rows.map((r) => `--${r[0].replace('/', '-')}:${r[4]}`).join(';');
---
<div class="demo" data-mapped-demo data-mode="light" style={light} data-light={light} data-dark={dark}>
  <div class="toggle" role="group" aria-label="Mode">
    <button type="button" data-set="light" aria-pressed="true">Light</button>
    <button type="button" data-set="dark" aria-pressed="false">Dark</button>
  </div>
  <div class="page">
    <div class="card">
      <h4>Design tokens, applied</h4>
      <p>Body text uses Text/body. The link uses <span class="link">Text/action</span>.</p>
      <span class="btn-fake">Get started</span>
      <span class="tint">Selected</span>
    </div>
  </div>
  <table>
    <thead><tr><th>Variable</th><th>Light</th><th>Dark</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr><td class="mono">{r[0]}</td><td data-col="light">{r[1]}</td><td data-col="dark">{r[3]}</td></tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .demo { padding: var(--brand-space-6); background: var(--surface-raised); border: var(--brand-border-1) solid var(--border-default); border-radius: var(--brand-radius-4); display: flex; flex-direction: column; gap: var(--brand-space-4); }
  .toggle { display: inline-flex; align-self: flex-start; border: var(--brand-border-1) solid var(--border-control); border-radius: var(--brand-radius-full); overflow: hidden; }
  .toggle button { background: none; border: 0; color: var(--text-secondary); padding: var(--brand-space-2) var(--brand-space-4); font: inherit; cursor: pointer; }
  .toggle button[aria-pressed='true'] { background: var(--surface-action); color: var(--text-on-action); font-weight: 600; }
  .page { background: var(--Surface-page); padding: var(--brand-space-6); border-radius: var(--brand-radius-3); transition: background 0.3s; }
  .card { background: var(--Surface-default); border: var(--brand-border-1) solid var(--Border-secondary); border-radius: var(--brand-radius-3); padding: var(--brand-space-6); display: flex; flex-direction: column; align-items: flex-start; gap: var(--brand-space-3); transition: background 0.3s, border-color 0.3s; }
  h4 { margin: 0; font-family: var(--brand-font-heading); font-weight: 400; font-size: 1.25rem; color: var(--Text-heading); }
  .card p { color: var(--Text-body); font-size: 0.97rem; }
  .link { color: var(--Text-action); text-decoration: underline; text-underline-offset: 3px; }
  .btn-fake { background: var(--Surface-action); color: var(--Text-on-action); padding: var(--brand-space-2) var(--brand-space-4); border-radius: var(--brand-radius-full); font-weight: 600; }
  .tint { background: var(--Surface-action-secondary); color: var(--Text-action); padding: 2px var(--brand-space-3); border-radius: var(--brand-radius-full); font-size: 0.85rem; }
  table { border-collapse: collapse; font-size: 0.85rem; width: 100%; }
  th, td { text-align: left; padding: 12px var(--brand-space-2); border-bottom: var(--brand-border-1) solid var(--border-default); }
  th { color: var(--text-secondary); font-weight: 500; }
  td { color: var(--text-default); }
  [data-mode='light'] [data-col='light'], [data-mode='dark'] [data-col='dark'] { color: var(--text-heading); font-weight: 600; }
  @media (max-width: 640px) {
    .demo { padding: var(--brand-space-4); }
    table { table-layout: fixed; font-size: 0.72rem; }
    th, td { padding: 10px 4px; overflow-wrap: anywhere; }
    th:first-child, td:first-child { width: 36%; }
  }
</style>
