---
// Default settings from the figma-type-scale SKILL.md table: [style, desktop size, desktop lh, mobile size, mobile lh]
const rows: [string, number, number, number, number][] = [
  ['Display/Default', 76, 92, 56, 68],
  ['Heading/H1', 60, 72, 48, 56],
  ['Heading/H2', 48, 56, 40, 48],
  ['Heading/H3', 40, 48, 32, 40],
  ['Body/Default', 16, 20, 16, 20],
  ['Caption/Default', 12, 16, 12, 16],
];
---
<div class="demo" data-type-demo data-mode="desktop">
  <div class="toggle" role="group" aria-label="Mode">
    <button type="button" data-set="desktop" aria-pressed="true">Desktop</button>
    <button type="button" data-set="mobile" aria-pressed="false">Mobile</button>
  </div>
  <ul>
    {rows.map(([name, ds, dl, ms, ml]) => (
      <li style={`--ds:${ds}px;--dl:${dl}px;--ms:${ms}px;--ml:${ml}px`}>
        <span class="mono meta">{name}<span class="sizes" data-d>{ds} / {dl}</span><span class="sizes" data-m>{ms} / {ml}</span></span>
        <span class="sample">Design tokens</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .demo { padding: var(--brand-space-6); background: var(--surface-raised); border: var(--brand-border-1) solid var(--border-default); border-radius: var(--brand-radius-4); display: flex; flex-direction: column; gap: var(--brand-space-4); }
  .toggle { display: inline-flex; align-self: flex-start; border: var(--brand-border-1) solid var(--border-control); border-radius: var(--brand-radius-full); overflow: hidden; }
  .toggle button { background: none; border: 0; color: var(--text-secondary); padding: var(--brand-space-2) var(--brand-space-4); font: inherit; cursor: pointer; }
  .toggle button[aria-pressed='true'] { background: var(--surface-action); color: var(--text-on-action); font-weight: 600; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  li { display: flex; flex-direction: column; padding-block: 12px; border-bottom: var(--brand-border-1) solid var(--border-default); overflow: hidden; }
  .meta { font-size: 0.75rem; color: var(--text-secondary); display: flex; justify-content: space-between; }
  .sample { font-family: var(--brand-font-heading); color: var(--text-heading); font-size: var(--ds); line-height: var(--dl); white-space: nowrap; transition: font-size 0.35s ease, line-height 0.35s ease; }
  @media (max-width: 640px) { .sample { white-space: normal; } }
  [data-mode='mobile'] .sample { font-size: var(--ms); line-height: var(--ml); }
  [data-mode='desktop'] [data-m], [data-mode='mobile'] [data-d] { display: none; }
</style>
