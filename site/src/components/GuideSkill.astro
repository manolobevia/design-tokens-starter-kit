---
interface Props { skill: string; title: string; line: string; does: string; see: string; needs: string; tweaks: { line: string; result: string }[]; n: number; }
const { skill, title, line, does, see, needs, tweaks, n } = Astro.props;
---
<section class="skill" id={skill.replace('figma-', '')}>
  <p class="eyebrow">Step {n} · {skill}</p>
  <h3>{title}</h3>
  <p>{does}</p>
  <dl>
    <dt>Type</dt>
    <dd><code class="line">{line}</code></dd>
    <dt>You will see</dt>
    <dd>{see}</dd>
    {needs && (<><dt>Run it after</dt><dd>{needs}</dd></>)}
  </dl>
  <details>
    <summary>Common tweaks</summary>
    <ul>
      {tweaks.map((t) => <li><code>{t.line}</code><span>{t.result}</span></li>)}
    </ul>
  </details>
</section>

<style>
  .skill { padding-block: var(--brand-space-8); border-top: var(--brand-border-1) solid var(--border-default); display: flex; flex-direction: column; gap: var(--brand-space-3); }
  .skill > p:not(.eyebrow) { color: var(--text-secondary); max-width: 40rem; }
  dl { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: var(--brand-space-2) var(--brand-space-4); margin: var(--brand-space-2) 0 0; }
  dt { color: var(--text-secondary); font-size: 0.9rem; padding-top: 2px; }
  dd { margin: 0; color: var(--text-default); }
  @media (max-width: 560px) { dl { grid-template-columns: 1fr; gap: 0; } dd { margin-bottom: var(--brand-space-3); } }
  .line { display: inline-block; background: var(--surface-sunken); color: var(--text-heading); padding: var(--brand-space-1) var(--brand-space-3); border-radius: var(--brand-radius-2); overflow-wrap: anywhere; }
  summary { cursor: pointer; color: var(--text-link); font-weight: 600; }
  ul { list-style: none; margin: var(--brand-space-3) 0 0; padding: 0; display: flex; flex-direction: column; gap: var(--brand-space-3); }
  li { display: flex; flex-direction: column; gap: var(--brand-space-1); }
  li code { align-self: flex-start; background: var(--surface-sunken); color: var(--text-heading); padding: 2px var(--brand-space-2); border-radius: var(--brand-radius-1); overflow-wrap: anywhere; }
  li span { color: var(--text-secondary); font-size: 0.97rem; }
</style>
