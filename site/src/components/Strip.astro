---
import { scale, ink } from '../scripts/scale';
interface Props { hex: string; }
const steps = scale(Astro.props.hex);
---
<ol class="strip" data-strip aria-label="The 11 generated steps, 950 to 50">
  {steps.map((s) => (
    <li style={`--c:${s.hex};--ink:${ink(s.hex)}`}><span>{s.step}</span></li>
  ))}
</ol>

<style is:global>
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(11, 1fr); border-radius: var(--brand-radius-3); overflow: hidden; }
  .strip li { background: var(--c); color: var(--ink); height: 112px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: var(--brand-space-2); font-family: var(--brand-font-mono); font-size: 0.7rem; }
  @media (max-width: 480px) { .strip li { font-size: 0.55rem; height: 88px; } }
  .anim .strip li { transition: opacity 0.35s ease, transform 0.35s ease; }
  .anim .strip.is-hidden li { opacity: 0; transform: translateY(10px); }
</style>
