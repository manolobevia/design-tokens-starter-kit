---
interface Props { title: string; skill: string; line: string; writes: string; }
const { title, skill, line, writes } = Astro.props;
---
<article class="card">
  <p class="eyebrow">{skill}</p>
  <h3>{title}</h3>
  <p class="line mono">{line}</p>
  <p class="writes">{writes}</p>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: var(--brand-space-3); padding: var(--brand-space-6); background: var(--surface-raised); border: var(--brand-border-1) solid var(--border-default); border-radius: var(--brand-radius-4); }
  .line { background: var(--surface-sunken); padding: var(--brand-space-2) var(--brand-space-3); border-radius: var(--brand-radius-2); color: var(--text-heading); overflow-wrap: anywhere; }
  .writes { color: var(--text-secondary); font-size: 0.97rem; }
</style>
