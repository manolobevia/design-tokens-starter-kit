---
import Base from '../layouts/Base.astro';
import HeroDemo from '../components/HeroDemo.astro';
import ColorDemo from '../components/ColorDemo.astro';
import AliasDemo from '../components/AliasDemo.astro';
import MappedDemo from '../components/MappedDemo.astro';
import SpacingDemo from '../components/SpacingDemo.astro';
import TypeDemo from '../components/TypeDemo.astro';
import ShapeDemo from '../components/ShapeDemo.astro';
import MotionDemo from '../components/MotionDemo.astro';
import ContrastDemo from '../components/ContrastDemo.astro';
import ExportDemo from '../components/ExportDemo.astro';
import StarterDemo from '../components/StarterDemo.astro';
import Divider from '../components/Divider.astro';
import { scale } from '../scripts/scale';

const ramp = scale('#5C3FC4');


const features = [
  {
    id: 'color',
    skill: 'figma-color-scale',
    title: 'One color in. Eleven steps out.',
    body: 'Give it a name and a hex. You get a full 950-to-50 scale in Brand, the same numbers you would get from the opacity trick by hand, minus the afternoon.',
    note: 'Live demo. The same math the skill uses.',
    line: 'Purple:#5C3FC4',
  },
  {
    id: 'alias',
    skill: 'figma-alias-bridge',
    title: 'Roles that follow your colors',
    body: 'Primary, Neutral, Error and friends are links into Brand, not copies. Swap the brand color later and every role updates with it.',
    note: 'Scripted preview.',
    line: 'Brand/Purple -> Alias/Primary (Purple)',
  },
  {
    id: 'mapped',
    skill: 'figma-mapped-roles',
    title: 'Light and Dark, already decided',
    body: 'Surface, Border, Text and Icon variables, each pointing at an Alias step. Dark mode mirrors Light, with exceptions where mirroring would fail contrast.',
    note: 'Values from the skill preset, with Purple as Primary and Gray as Neutral.',
    line: 'Mapped dark',
  },
  {
    id: 'spacing',
    skill: 'figma-spacing',
    title: 'Spacing that sticks to the grid',
    body: 'A fixed scale in 4px units. Spacing/4 is 16px, every time, in every file.',
    note: 'Default scale, subset shown.',
    line: 'Spacing',
  },
  {
    id: 'type',
    skill: 'figma-type-scale',
    title: 'Type that flexes between Desktop and Mobile',
    body: 'Font variables, a size scale with a Desktop and a Mobile mode, and text styles bound to both. One command, no spreadsheet.',
    note: 'Default settings: base 16, ratio 1.25 Desktop and 1.2 Mobile.',
    line: 'Typography',
  },
  {
    id: 'shape',
    skill: 'figma-radius · figma-border-width',
    title: 'Corners and borders, on a scale',
    body: 'Border radius from square to a full pill, and four border weights, all in 4px units. Pick one of each and watch the same card, button and avatar follow.',
    note: 'Interactive. The values are the two skills\u2019 fixed scales.',
    line: 'Border radius',
  },
  {
    id: 'motion',
    skill: 'figma-motion',
    title: 'Timing and easing you can feel',
    body: 'Durations from 250ms to 2500ms and four easing curves, stored as Figma\u2019s own timing and easing variables.',
    note: 'Interactive. The durations and curves are the skill\u2019s presets.',
    line: 'Motion',
  },
  {
    id: 'contrast',
    skill: 'figma-contrast-fix',
    title: 'Fix the colors that fail',
    body: 'Finds Mapped pairs below WCAG AA and previews a passing step from the same role. Nothing changes until you ask to apply.',
    note: 'Live demo of the rule, for one pair.',
    line: 'Contrast fix',
  },
  {
    id: 'export',
    skill: 'figma-export-tokens',
    title: 'Tokens as code',
    body: 'CSS custom properties, W3C design tokens JSON and a Tailwind v4 theme, with references kept as references.',
    note: 'A trimmed sample of the skill\u2019s real output.',
    line: 'Export tokens',
  },
  {
    id: 'starter',
    skill: 'figma-starter',
    title: 'The whole system from one line',
    body: 'Give it one to four brand colors and a font pair. It runs every skill above in order, and a dry run shows the plan first.',
    note: 'Scripted preview of the run order.',
    line: '/figma-starter Plum:#3B1A53 ...',
  },
];

const benefits = [
  { title: 'Faster setup', text: 'A whole system in minutes, not days.', icon: ['M13 2 4 14h7l-1 8 9-12h-7z'] },
  { title: 'Consistent naming', text: 'The same names in every file you start.', icon: ['M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z', 'M7.5 8.5h.01'] },
  { title: 'Structure that scales', text: 'Brand, Alias and Mapped keep changes in one place.', icon: ['M12 2 2 7l10 5 10-5-10-5z', 'M2 17l10 5 10-5', 'M2 12l10 5 10-5'] },
  { title: 'No code required', text: 'You type short lines. Claude does the scripting.', icon: ['M4 6h16', 'M4 12h10', 'M4 18h6'] },
  { title: 'Free and open source', text: 'MIT licensed. Use it, change it, share it.', icon: ['M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z'] },
];

const howSteps = [
  { title: 'Install the skills', text: 'Download the project once. The Guide shows how.' },
  { title: 'Type a short line', text: 'Like <code>Purple:#5C3FC4</code> or <code>Spacing</code>. That is the whole request.' },
  { title: 'Watch Figma fill up', text: 'Real variables and text styles land in your open file.' },
];

const faq = [
  ['Do I need Claude Code?', 'Yes. The skills run inside Claude Code and write to your Figma file through the Figma Console MCP.'],
  ['Do I need GitHub?', 'No account needed. You <a href="https://github.com/manolobevia/design-tokens-starter-kit/archive/refs/heads/main.zip">download the project</a> once, and the <a href="/guide">Guide</a> walks you through it in plain steps.'],
  ['Will it overwrite my existing variables?', 'It writes to the Brand, Alias, Mapped and Responsive collections. A variable with the same name has its value updated in place, and hand-tuned Mapped values are kept unless you ask for a reset. Add dry run to any line to see what would happen first.'],
  ['Is it free?', 'Yes. It is open source under the MIT license, including for commercial work.'],
];
---
<Base
  overlay
  title="Design Token Skills: Figma design tokens from one line in Claude Code"
  description="Free, open-source Claude Code skills that write a complete design token system into your Figma file from short typed lines."
>
  <section class="section hero" data-glow style="--glow-color:#5C3FC4">
    <div class="strip" aria-hidden="true">
      {ramp.map((s) => <span style={`background:${s.hex}`}></span>)}
    </div>
    <div class="container hero-grid">
      <div>
        <h1>Type one line. Watch Figma fill with tokens.</h1>
        <p class="lead">Claude Code skills that write real variables and text styles into your Figma file. Free and open source.</p>
        <p class="actions">
          <a class="btn btn--primary" href="/guide#install">Get started</a>
          <a class="btn" href="https://github.com/manolobevia/design-tokens-starter-kit">GitHub</a>
        </p>
      </div>
      <HeroDemo />
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <h2>How it works</h2>
      <ol class="steps">
        {howSteps.map((st, i) => (
          <li>
            <span class="icon n mono" aria-hidden="true">{i + 1}</span>
            <h3>{st.title}</h3>
            <p set:html={st.text} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section tight" id="skills">
    <div class="container">
      <h2>Twelve skills, one system</h2>
      <p class="lead sub">Every one of them, interactive. Try them below.</p>
      {features.map((f, i) => (
        <Fragment>
        {i > 0 && <Divider kind={f.id} />}
        <article class:list={['feature', { flip: i % 2 === 1 }]} id={f.id}>
          <div class="copy">
                        <p class="eyebrow">{f.skill}</p>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <p class="mono typed-line">{f.line}</p>
            <p class="note">{f.note}</p>
          
          </div>
          <div class="demo-col">
            {f.id === 'color' && <ColorDemo />}
            {f.id === 'alias' && <AliasDemo />}
            {f.id === 'mapped' && <MappedDemo />}
            {f.id === 'spacing' && <SpacingDemo />}
            {f.id === 'type' && <TypeDemo />}
            {f.id === 'shape' && <ShapeDemo />}
            {f.id === 'motion' && <MotionDemo />}
            {f.id === 'contrast' && <ContrastDemo />}
            {f.id === 'export' && <ExportDemo />}
            {f.id === 'starter' && <StarterDemo />}
          </div>
        </article>
        </Fragment>
      ))}

      <Divider kind="docs" />
      <article class="feature" id="docs">
        <div class="copy">
                      <p class="eyebrow">figma-token-docs</p>
          <h3>A page that documents it all</h3>
          <p>One frame per section, generated from your live variables. Rerun it after a change and the page refreshes.</p>
          <p class="mono typed-line">Design Tokens</p>
          <p class="note">A real screenshot of the Contents frame.</p>
        
          </div>
        <div class="demo-col">
          <div class="d-box">
            <img class="d-shot" src="/design-tokens-contents.png" width="1440" height="1280" alt="The Contents frame of the Design Tokens page in Figma: a card for each section of the system" loading="lazy" />
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <h2>Why designers like it</h2>
      <ul class="benefits">
        {benefits.map((b) => (
          <li>
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                {b.icon.map((d) => <path d={d} />)}
              </svg>
            </span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="for">
        <p class="eyebrow">Who it is for</p>
        <p class="statement">Designers who want design tokens fast, so they can move on to components and patterns.</p>
        <ul class="needs">
          <li>
            <span class="check" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
            <h3>No scripting</h3>
            <p>The variables are written to Figma for you. You never write code.</p>
          </li>
          <li>
            <span class="check" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
            <h3>No Git or GitHub</h3>
            <p>Download the skills once and use them. No repositories or commands to learn.</p>
          </li>
          <li>
            <span class="check" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
            <h3>Just Claude Code and Figma</h3>
            <p>A Claude Code account and Figma are all it takes to run the skills.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <h2>Questions</h2>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details><summary>{q}</summary><p set:html={a} /></details>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="container narrow">
      <h2>Build your design tokens in a few lines</h2>
      <p class="actions">
        <a class="btn btn--primary" href="/guide#install">Get started</a>
        <a class="btn" href="https://github.com/manolobevia/design-tokens-starter-kit">GitHub</a>
      </p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/demos';
  import '../scripts/demos2';
</script>

<style>
  .hero { position: relative; overflow: hidden; padding-top: 294px; padding-bottom: var(--brand-space-16); }
  .hero::before { content: ''; position: absolute; left: calc(50% + 40px); top: -300px; width: 900px; height: 900px; background: radial-gradient(closest-side, color-mix(in srgb, var(--glow-color) 24%, transparent), transparent); transition: background 1.2s ease; pointer-events: none; }
  .strip { position: absolute; left: 14px; top: -9px; width: 1865px; height: 819px; display: flex; opacity: 0.16; pointer-events: none; z-index: 5; -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 40%, #000 55%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, #000 40%, #000 55%, transparent 100%); }
  .strip span { flex: 1; }
  @media (max-width: 1100px) { .strip { left: 0; width: 100%; } }
  @media (max-width: 640px) { .hero { padding-top: 132px; } }
  .hero-grid { position: relative; display: grid; gap: var(--brand-space-12); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  
  .lead { margin-top: var(--brand-space-6); max-width: 38rem; font-size: 1.2rem; color: var(--text-secondary); }
  .lead.sub { margin-top: var(--brand-space-3); }
  .actions { margin-top: var(--brand-space-8); display: flex; flex-wrap: wrap; gap: var(--brand-space-3); }
  .tight { padding-block: var(--brand-space-16); }
  .narrow { width: min(100% - 2 * var(--brand-space-4), 720px); }

  .steps { list-style: none; margin: var(--brand-space-8) 0 0; padding: 0; display: grid; gap: var(--brand-space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .steps li { padding: var(--brand-space-6); background: var(--surface-raised); border: var(--brand-border-1) solid var(--border-default); border-radius: var(--brand-radius-4); display: flex; flex-direction: column; gap: var(--brand-space-3); }
  .n { color: var(--text-link); font-size: 1rem; }
  .steps p { color: var(--text-secondary); }

  .feature { margin-top: var(--brand-space-16); display: grid; gap: var(--brand-space-8); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 900px) {
    .feature { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: var(--brand-space-12); }
    .feature.flip .copy { order: 2; }
  }
  .copy { display: flex; flex-direction: column; gap: var(--brand-space-3); }
  .copy > p:not(.eyebrow):not(.typed-line):not(.note) { color: var(--text-secondary); }
  .typed-line { align-self: flex-start; background: var(--surface-sunken); color: var(--text-heading); padding: var(--brand-space-2) var(--brand-space-3); border-radius: var(--brand-radius-2); overflow-wrap: anywhere; }
  .note { color: var(--text-secondary); font-size: 0.85rem; }
  .grid { margin-top: var(--brand-space-6); display: grid; gap: var(--brand-space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }

  .benefits { list-style: none; margin: var(--brand-space-8) 0 0; padding: 0; display: grid; gap: var(--brand-space-8) var(--brand-space-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .benefits li { position: relative; display: flex; flex-direction: column; gap: var(--brand-space-2); }
  .benefits p { color: var(--text-secondary); }
  .icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-bottom: var(--brand-space-2); border-radius: var(--brand-radius-3); background: var(--surface-raised); border: var(--brand-border-1) solid var(--border-default); color: var(--text-link); }
  @media (min-width: 960px) {
    .benefits { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; }
    .benefits li { padding-inline: var(--brand-space-6); }
    .benefits li:first-child { padding-left: 0; }
    .benefits li + li::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: linear-gradient(to bottom, transparent, var(--border-default) 25%, var(--border-default) 75%, transparent); }
  }

  .for { padding: var(--brand-space-12) var(--brand-space-8); border: var(--brand-border-1) solid var(--border-default); border-radius: var(--brand-radius-4); background: radial-gradient(70% 120% at 0% 0%, color-mix(in srgb, var(--alias-primary-500) 18%, transparent), transparent), var(--surface-raised); display: flex; flex-direction: column; gap: var(--brand-space-6); }
  @media (max-width: 560px) { .for { padding: var(--brand-space-8) var(--brand-space-6); } }
  .statement { font-family: var(--brand-font-heading); font-weight: 400; font-size: clamp(1.75rem, 4.2vw, 3rem); line-height: 1.12; letter-spacing: -0.02em; color: var(--text-heading); max-width: 24ch; }
  .needs { list-style: none; margin: var(--brand-space-4) 0 0; padding: 0; display: grid; gap: var(--brand-space-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .needs li { display: flex; flex-direction: column; gap: var(--brand-space-2); }
  .needs p { color: var(--text-secondary); }
  .check { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: var(--brand-radius-full); background: var(--surface-action); color: var(--text-on-action); margin-bottom: var(--brand-space-1); }
  .faq { margin-top: var(--brand-space-6); border-top: var(--brand-border-1) solid var(--border-default); }
  details { border-bottom: var(--brand-border-1) solid var(--border-default); padding-block: var(--brand-space-4); }
  summary { cursor: pointer; font-weight: 600; color: var(--text-heading); }
  details p { margin-top: var(--brand-space-3); color: var(--text-secondary); }

  .cta { text-align: center; }
  .cta .actions { justify-content: center; }
</style>
