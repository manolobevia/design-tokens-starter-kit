    {
      "@type": "FAQPage",
      "@id": "https://designtokenskills.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do I need Claude Code?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The skills run inside Claude Code and write to your Figma file through the Figma Console MCP."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need GitHub?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No account needed. You download the project once, and the Guide walks you through it in plain steps."
          }
        },
        {
          "@type": "Question",
          "name": "Will it overwrite my existing variables?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not the ones you tuned by hand. If you edit a value in Mapped, Spacing, Border radius, Border width, Motion or your type styles, a re-run keeps your edit. To put one back on the preset, use that skill’s reset line, such as reset Mapped/Text, reset Spacing, reset Border radius, reset Border width, reset Motion, reset Responsive or reset type styles. Three things do overwrite: color scales and alias links (re-running Purple:#5C3FC4 rewrites every Purple step, even with the same hex, and there is no reset), a Typography line that names settings such as base 18, and the generated Design Tokens page and export files. Add dry run to a line to preview it. For color scales and the starter it shows the plan, not each variable."
          }
        },
        {
          "@type": "Question",
          "name": "Is this for starting a system or maintaining one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For starting one. The skills build a consistent base fast: scales, roles, Light and Dark usage, spacing, type and more. After that, the system is yours to edit in Figma. Add steps like 850, tune a disabled gray, or darken a danger color by hand. The skills won’t track why you made those changes, so a note in the variable’s description field is a good habit."
          }
        },
        {
          "@type": "Question",
          "name": "Can I add my own steps, like Purple/850?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in Figma. Skills only write the names they generate, so a custom name is not part of what they write."
          }
        },
        {
          "@type": "Question",
          "name": "Is it free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. It is open source under the MIT license, including for commercial work."
          }
        }
      ]
    }
  ]
}
