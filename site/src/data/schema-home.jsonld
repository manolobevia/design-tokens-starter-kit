    {
      "@type": "FAQPage",
      "@id": "https://designtokenskills.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do I need Claude Code?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. The skills run inside Claude Code and write to your Figma file through the Figma Console MCP." }
        },
        {
          "@type": "Question",
          "name": "Do I need GitHub?",
          "acceptedAnswer": { "@type": "Answer", "text": "No account needed. You download the project once, and the Guide walks you through it in plain steps." }
        },
        {
          "@type": "Question",
          "name": "Will it overwrite my existing variables?",
          "acceptedAnswer": { "@type": "Answer", "text": "It writes to the Brand, Alias, Mapped and Responsive collections. A variable with the same name has its value updated in place, and hand-tuned Mapped values are kept unless you ask for a reset. Add dry run to any line to see what would happen first." }
        },
        {
          "@type": "Question",
          "name": "Is it free?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. It is open source under the MIT license, including for commercial work." }
        }
      ]
